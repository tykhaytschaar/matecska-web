# Supabase projekt adatai (Dashboard → Project Settings → API). Nyilvános értékek, a kliensbe kerülnek.
# Fejlesztéshez másold .env.local néven (az nincs verziókezelve).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# A karakter-katalógus bucketje; alapból a Supabase-projekt characters bucketje.
# VITE_CATALOG_URL=https://xxxxxxxxxxxx.supabase.co/storage/v1/object/public/characters/
# Fejlesztéshez szerver nélkül (csak `npm run dev` alatt hat): memóriabeli utánzat, bármilyen hatjegyű kód belép.
# VITE_FAKE_BACKEND=1
